# Copia este fichero a .env.local y rellena los valores de tu proyecto.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Panel /admin. No usa Supabase Auth: va con su propia cookie de servidor.
# Sin estas variables, lib/admin-server.ts cae en valores por defecto
# publicados en el repositorio — en producción hay que ponerlas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cadena larga y aleatoria: es el valor que se guarda en la cookie de sesión.
ADMIN_SESSION_SECRET=

# Pendiente (fase 2 de supabase/rls.sql): cuando el panel /admin pase a leer
# desde el servidor, hará falta la service_role key. NO se expone al navegador,
# así que va sin el prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
